# --- Higgsfield server ------------------------------------------------
PORT=8788

# --- Image generation (Phase 3) — real, works on the free tier --------
# Free key: https://aistudio.google.com/apikey  (same key pin-factory uses)
GEMINI_API_KEY=
# Optional override (default gemini-2.5-flash-image):
# IMAGE_MODEL=gemini-2.5-flash-image

# --- Video generation (Phase 4) — fal.ai image→video, optional, paid --
# Key: https://fal.ai/dashboard/keys  (pay-per-use; roughly $0.05–$0.5 per clip
# depending on model and duration). Without a key the server falls back to a
# keyless animated-SVG stub video provider, so the whole Animate flow still
# works for $0.
FAL_KEY=
# Optional override (default fal-ai/kling-video/v2.1/standard/image-to-video):
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
