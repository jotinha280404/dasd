# Higgsfield web — Vite build served by nginx. Build context = repo ROOT.
FROM node:24-alpine AS build
WORKDIR /app
COPY . .
RUN npm ci && npm run build -w @dasd/higgsfield-web

FROM nginx:alpine
COPY higgsfield/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/higgsfield/web/dist /usr/share/nginx/html
EXPOSE 80
