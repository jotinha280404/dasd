# --- Image generation -------------------------------------------------
# Free API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the image model (default gemini-2.5-flash-image)
# IMAGE_MODEL=gemini-2.5-flash-image

# --- Affiliates (fill in as your accounts get approved) ---------------
# Amazon Associates US (https://affiliate-program.amazon.com)
AMAZON_US_TAG=YOURTAG-20
# Amazon Associates BR (https://associados.amazon.com.br)
AMAZON_BR_TAG=SEUTAG-20
# Mercado Livre: generate links in the affiliates portal
# (https://www.mercadolivre.com.br/afiliados) — optional URL suffix:
ML_AFFILIATE_SUFFIX=
# Which marketplace PT pins link to: "ml" (Mercado Livre) or "amazon"
PT_MARKETPLACE=ml

# --- Publishing --------------------------------------------------------
# Public base URL where output/images/... is reachable. Default is this
# repo's raw.githubusercontent.com URL (commit + push images first).
# MEDIA_BASE_URL=https://res.cloudinary.com/yourcloud/raw/upload/v1
