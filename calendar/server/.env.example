# --- Calendar server --------------------------------------------------
PORT=8790

# --- Chat assistant (message Claude to create events) -----------------
# Uses local Claude Code auth by default (same $0 path as the orchestrator):
# a CLAUDE_CODE_OAUTH_TOKEN, or a prior `claude` login. AGENT_MODE=auto|mock|sdk.
#   auto = real Claude if auth is found, else a heuristic mock parser
# AGENT_MODE=auto
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# --- Calendar provider ------------------------------------------------
# Default 'local' store needs no keys. Google Calendar is a drop-in adapter
# (needs an OAuth client + token); leave blank to use the local calendar.
# CALENDAR_PROVIDER=local          # local | google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
