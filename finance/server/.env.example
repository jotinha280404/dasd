# --- Finance server ---------------------------------------------------
PORT=8789

# --- Investment prices (optional) -------------------------------------
# The app works fully with manually-entered prices. A price provider is a
# drop-in adapter; without a key, holdings use their last manual price.
# PRICE_PROVIDER=none            # none | stooq | ...
# PRICE_API_KEY=

# --- Bank sync (optional, later) --------------------------------------
# Manual entry + CSV import need no keys. Bank connect is a swappable adapter.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
