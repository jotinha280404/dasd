# --- Orchestrator server ----------------------------------------------
PORT=8787

# --- Real Claude Code agents (Phase 1) --------------------------------
# The $0 path: a Claude Pro/Max subscription token. Mint it once with:
#   claude setup-token
# CLAUDE_CODE_OAUTH_TOKEN=

# ...or run agents on a metered API key instead:
# ANTHROPIC_API_KEY=

# Default working directory agents operate in (Phase 1). Leave blank to use
# a per-run sandbox scratch dir (safest). Set to a repo path to let agents
# work on real code.
# AGENT_CWD=
