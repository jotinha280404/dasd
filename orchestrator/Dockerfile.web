# Orchestrator web — Vite build served by nginx. Build context = repo ROOT.
FROM node:24-alpine AS build
WORKDIR /app
COPY . .
RUN npm ci && npm run build -w @dasd/orchestrator-web

FROM nginx:alpine
COPY orchestrator/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/orchestrator/web/dist /usr/share/nginx/html
EXPOSE 80
